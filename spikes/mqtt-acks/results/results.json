      "snapshotFileMB": 103.6,
      "longestBrokerStallDuringSnapshotMs": 3182,
      "snapshotLog": [
        "2026-10-14T11:05:47: Saving in-memory database to /mosquitto/data//mosquitto.db."
      ]
    }
  },
  "deferred-hold-keeps-keepalive": {
    "id": "deferred-hold-keeps-keepalive",
