        "11",
        "13",
        "15",
        "17",
        "19",
        "21",
        "23"
      ],
      "uniqueStored": 44,
      "lost": 20
    }
  },
  "memory-and-snapshot-at-240k": {
    "id": "memory-and-snapshot-at-240k",
    "tier": "record",
    "proves": "Broker RSS at 240k queued messages, bytes per queued message, and the stall a full snapshot causes",
