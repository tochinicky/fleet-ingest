# D8, S8-6: Caddy in front of the API and Grafana, with automatic HTTPS, on one name: the VM's DNS label
# (<label>.<region>.cloudapp.azure.com, a Let's Encrypt certificate), or `localhost` locally, which Caddy serves with
# its own internal CA. The API is at the root, Grafana under /grafana/ (it serves from that sub-path itself).
# Prometheus, Alertmanager and Postgres are never proxied.
# The ACME account email, when there is one: `email <address>` from CADDY_ACME_EMAIL (compose.production.yaml), or
# nothing, because certificate authorities reject placeholder addresses (S8-8).
{
	{$CADDY_ACME_EMAIL}
}

{$PUBLIC_HOST} {
	encode zstd gzip
	handle /grafana/* {
		reverse_proxy grafana:3000
	}
	handle {
		reverse_proxy api:8080
	}
}
