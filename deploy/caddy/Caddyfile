# D8: Caddy in front of the API and Grafana, with automatic HTTPS. On the VM, the hosts are sslip.io names for its
# IP (a public certificate from Let's Encrypt); locally they're *.localhost names, which Caddy serves with its own
# internal CA. Prometheus, Alertmanager and Postgres are never proxied.
{
	email {$ACME_EMAIL:admin@example.invalid}
}

{$API_HOST} {
	encode zstd gzip
	reverse_proxy api:8080
}

{$GRAFANA_HOST} {
	encode zstd gzip
	reverse_proxy grafana:3000
}
