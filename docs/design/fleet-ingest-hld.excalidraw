   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 244051093,
   "version": 1,
   "versionNonce": 1067275002,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "What stays the same (why Stage 1 rules matter)\n· idempotent key (device, epoch, seq), so redelivery is harmless\n· ack / commit offsets only after a durable write\n· per-gateway identity, enforced by the broker\n\nNew costs\n· more moving parts → prefer managed services · capacity planning per partition",
   "originalText": "What stays the same (why Stage 1 rules matter)\n· idempotent key (device, epoch, seq), so redelivery is harmless\n· ack / commit offsets only after a durable write\n· per-gateway identity, enforced by the broker\n\nNew costs\n· more moving parts → prefer managed services · capacity planning per partition",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rectangle-136",
   "lineHeight": 1.25,
